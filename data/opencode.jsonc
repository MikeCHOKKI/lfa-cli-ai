{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "general",
  "skills": {
    "paths": ["./skills"]
  },
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "edit": "ask",
    "bash": { "git *": "allow", "*": "ask" },
    "external_directory": { "${HOME}/**": "allow", "*": "ask" },
    "skill": "ask"
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx", "-y", "@modelcontextprotocol/server-filesystem@0.6.2",
        "${HOME}/Projects",
        "${HOME}/dev",
        "${HOME}/code",
        "${HOME}/workspace"
      ]
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory@0.6.2"]
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github@0.6.2"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch@0.1.4"]
    }
  }
}
