{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "general",
  "skills": {
    "paths": [
      "./skills"
    ]
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow"
    },
    "edit": "ask",
    "external_directory": {
      "*": "ask",
      "${HOME}/**": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "read": "allow",
    "skill": "ask",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "fetch": {
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "type": "local"
    },
    "filesystem": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${HOME}/Projects",
        "${HOME}/dev",
        "${HOME}/code",
        "${HOME}/workspace"
      ],
      "type": "local"
    },
    "github": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "type": "local"
    },
    "memory": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "type": "local"
    },
    "ollama": {
      "type": "local",
      "command": ["npx", "-y", "ollama-mcp"]
    }
  }
}
